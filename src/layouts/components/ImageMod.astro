---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  fit?: "cover" | "contain" | "fill" | "none" | "scale-down";
  class?: string;
  style?: any;
  quality?: number;
}

let {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  fit,
  style,
  quality,
} = Astro.props;

const isRemote = src.startsWith("http://") || src.startsWith("https://");

const images = import.meta.glob("/public/images/**/*.{jpeg,jpg,png,gif}");

const localSrc = isRemote ? null : `/public${src}`;

const isValidLocalPath =
  !isRemote && localSrc && images[localSrc] ? true : false;

if (!isRemote && !isValidLocalPath) {
  console.error(
    `\x1b[31mImage not found - ${localSrc}.\x1b[0m Make sure the image is in the /public/images folder.`,
  );
}
---

{
  isRemote ? (
      <Image
        src={src}
        alt={alt}
        width={width}
        height={height}
        inferSize={true}
        loading={loading}
        fit={fit ? fit : "contain"}
        decoding={decoding}
        class={className}
        format={format}
        style={style}
        quality={quality}
/>
  ) : (
    isValidLocalPath && (
      <Image
        src={images[localSrc!]() as Promise<{ default: ImageMetadata }>}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        fit={fit ? fit : "contain"}
        decoding={decoding}
        class={className}
        format={format}
        style={style}
        quality={quality}
      />
    )
  )
}