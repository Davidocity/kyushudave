---
import { humanize } from "@/lib/utils/textConverter";
import { getDestination } from "@/data/destinations";

interface Props {
  className?: string;
  title: string;
  prefecture?: string;
  destination?: string;
  area?: string;
}

const {
  className,
  title,
  prefecture,
  destination,
  area,
}: Props = Astro.props;

const destinationData = destination
  ? getDestination(destination as any)
  : undefined;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex flex-wrap" role="list">
    <li class="mx-1" role="listitem">
      <a href="/" class="text-primary">
        Kyushu
      </a>
    </li>

    {prefecture && (
      <li class="mx-1" role="listitem">
        <span class="inline-block mr-1" aria-hidden="true">/</span>
        <span class="text-text-light">
          {humanize(prefecture)} Prefecture
        </span>
      </li>
    )}

    {destinationData && (
      <li class="mx-1" role="listitem">
        <span class="inline-block mr-1" aria-hidden="true">/</span>
        <span class="text-text-light">
          {destinationData.name}
        </span>
      </li>
    )}

    {area && (
      <li class="mx-1" role="listitem">
        <span class="inline-block mr-1" aria-hidden="true">/</span>
        <span class="text-text-light">
          {humanize(area)}
        </span>
      </li>
    )}

    <li class="mx-1" role="listitem" aria-current="page">
      <span class="inline-block mr-1" aria-hidden="true">/</span>
      <span class="text-text-light">
        {title}
      </span>
    </li>
  </ol>
</nav>