---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import ImageMod from "../ImageMod.astro";

const post = Astro.props;

const {
  image,
  images,
  title,
  date,
  categories = [],
  experiences = [],
  summary,
} = post?.post?.data;

const { id } = post?.post;

// Prefer the new single hero image field.
// Fall back to the first legacy images[] item if needed.
const cardImage = image || images?.[0];
---

{cardImage && (
  <div class="post-slider">
    <a href={`/post/${id}/`}>
      <ImageMod
        src={cardImage}
        alt={title}
        width={0}
        height={0}
        class="rounded-sm"
      />
    </a>
  </div>
)}

<div class="card-body">
  <h3>
    <a
      class="post-title"
      href={`/post/${id}/`}
      set:html={title}
    />
  </h3>

  <ul class="post-meta">
  <li>
    Date :{" "}
    <span class="meta-link">
      {dateFormat(date)}
    </span>
  </li>

  {categories.length > 0 && (
  <li>
    Categories :
    {
      categories.map((c: string) => (
        <a
          href={`/categories/${slugify(c)}/`}
          class="ms-1 meta-link"
        >
          {humanize(c)}
        </a>
      ))
    }
  </li>
)}

{experiences.length > 0 && (
  <li>
    Experiences :
    {
      experiences.map((experience: string) => (
        <a
          href={`/experiences/${slugify(experience)}/`}
          class="ms-1 meta-link"
        >
          {humanize(experience)}
        </a>
      ))
    }
  </li>
)}
</ul>

  {summary && <p set:html={plainify(summary)} />}

  <a href={`/post/${id}/`} class="btn btn-outline-primary">
    Continue Reading
  </a>
</div>