---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import ImageMod from "../ImageMod.astro";

const post = Astro.props;

const { images, title, date, categories, tags, summary } =
  post?.post?.data;

const { id } = post?.post;
---

<div class="post-slider">
  <a href={`/post/${id}/`}>
    <ImageMod
      src={images[0]}
      alt={title}
      width={0}
      height={0}
      class="rounded-sm"
    />
  </a>
</div>

<div class="card-body">
  <h3>
    <a
      class="post-title"
      href={`/post/${id}/`}
      set:html={title}
    />
  </h3>

  <ul class="post-meta">
    <li>
      Date :{" "}
      <span class="meta-link">
        {dateFormat(date)}
      </span>
    </li>

    <li>
      Categories :
      {
        categories.map((c: string) => (
          <a
            href={`/categories/${slugify(c)}/`}
            class="ms-1 meta-link"
          >
            {humanize(c)}
          </a>
        ))
      }
    </li>

    <li>
      Tags :
      {
        tags.map((t: string) => (
          <a
            href={`/tags/${slugify(t)}/`}
            class="ms-1 meta-link"
          >
            {humanize(t)}
          </a>
        ))
      }
    </li>
  </ul>

  {summary && <p set:html={plainify(summary)} />}

  <a href={`/post/${id}/`} class="btn btn-outline-primary">
    Continue Reading
  </a>
</div>