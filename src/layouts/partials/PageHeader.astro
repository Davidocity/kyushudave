---
import Social from "@/components/Social.astro";
import { markdownify } from "@/lib/utils/textConverter";

const {
  pretitle = "",
  title = "",
  social,
}: { pretitle?: string; title?: string; social?: any } = Astro.props;
---

<div class="mb-8 border-b border-border pb-4">
<h1 class="h2 font-semibold mb-0">
  {pretitle && pretitle}
  <span class={`${pretitle ? "text-primary" : ""}`}>
    {markdownify(title)}
  </span>
</h1>
</div>
