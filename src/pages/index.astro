---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Full from "@/layouts/Full.astro";
import FullLeft from "@/layouts/FullLeft.astro";
import FullRight from "@/layouts/FullRight.astro";
import Grid from "@/layouts/Grid.astro";
import GridLeft from "@/layouts/GridLeft.astro";
import GridRight from "@/layouts/GridRight.astro";
import List from "@/layouts/List.astro";
import ListLeft from "@/layouts/ListLeft.astro";
import ListRight from "@/layouts/ListRight.astro";

const layouts: any = {
  full: Full,
  fullRight: FullRight,
  fullLeft: FullLeft,
  grid: Grid,
  gridLeft: GridLeft,
  gridRight: GridRight,
  list: List,
  listLeft: ListLeft,
  listRight: ListRight,
};

const selectedLayout = config.settings.default_layout;
const LayoutComponent = layouts[selectedLayout];
---

<Base
  title="KyushuDave | Independent Kyushu Travel Guides"
  meta_title="Kyushu Travel Guides, Food, Culture, and Outdoors"
  description="Independent travel guides to Kyushu’s cities, food, culture, mountains, and lesser-known places."
>
  <section class="pt-12 pb-18">
    <div class="container">
      <div class="max-w-4xl py-1 lg:py-1">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-primary">
          Travel & Photo Journal
        </p>

        <h1 class="mb-5 text-4xl font-black leading-tight text-text-dark lg:text-5xl">
          Kyushu, As I’ve Experienced It
        </h1>

            <div class="max-w-3xl text-lg leading-6 text-text space-y-4">
              <p>
                Hi, I’m Kyushu Dave. I live here. I wander around. I take pictures. I eat things, climb things, get lost occasionally, and try to figure out what makes Kyushu—and Japan—such an interesting place.
              </p>

              <p>
                My relationship with Japan goes back to 1988, but I’m still discovering it. This is where I write about the places I’ve been, the experiences I’ve had, and the places I’m curious enough to visit next.
              </p>

              <p>
                No definitive guide. No claim to know everything. Just what I’ve seen, what I think, and what I’ve photographed along the way.
              </p>

              <p>
                <a href="/about" class="text-primary hover:underline">Read more about me →</a>
              </p>
            </div>
      </div>
    </div>
  </section>

  {LayoutComponent && <LayoutComponent />}
</Base>