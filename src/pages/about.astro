---
import ImageMod from "@/components/ImageMod.astro";
import Social from "@/components/Social.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

const about = await getListPage("about", "-index");
const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && about.data.draft) return Astro.redirect("/404");
const { Content } = await render(about);
const { title, description, meta_title, image, image_caption, social } = about.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12">
          <div class="title-bordered mb-5 flex items-center justify-between">
            <h1 class="h4 fw-normal" set:html={markdownify(title)} />
            <Social
              source={social}
              className="hidden lg:block social-icons me-3"
            />
          </div>

            {
              image && (
                <figure class="mb-6">
                  <ImageMod
                    class="mx-auto w-full rounded-sm"
                    src={image}
                    width={2048}
                    height={1461}
                    alt={title}
                    format="webp"
                  />

                  {image_caption && (
                    <figcaption class="mt-2 text-center text-sm italic text-text-light">
                      {image_caption}
                    </figcaption>
                  )}
                </figure>
              )
            }
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
