{
  "name": "logbook-astro",
  "version": "3.2.1",
  "description": "LogBook Astro SAAS Theme",
  "author": "themefiser",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate-json && astro dev",
    "build": "pnpm run generate-json && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier -w ./src",
    "generate-json": "node scripts/jsonGenerator.js",
    "deploy:cf-workers": "pnpm run build && wrangler deploy",
    "preview:cf-workers": "pnpm run build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.0",
    "@astrojs/sitemap": "3.7.3",
    "@digi4care/astro-google-tagmanager": "^2.0.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "7.0.3",
    "astro-auto-import": "^0.5.1",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.5",
    "photoswipe": "^5.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "swiper": "^14.0.0",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.6.0",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "0.35.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.105.0"
  }
}
